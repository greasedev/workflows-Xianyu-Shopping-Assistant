{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@greaseclaw/workflow-sdk": ["node_modules/@greaseclaw/workflow-sdk/dist/index.local"],
      "@greaseclaw/workflow-sdk/*": ["node_modules/@greaseclaw/workflow-sdk/dist/*"]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false
  },
  "include": ["src/"],
  "exclude": ["node_modules", "dist"]
}
